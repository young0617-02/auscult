# 云端 baseline 连接配置：含直填的 API key，禁止入库
#（安全兜底：若移除忽略，则 key 将随 git 提交泄露）
env/cloud.json

# Python 字节码缓存与虚拟环境（可再生，不入库）
__pycache__/
*.pyc
.venv/
# MinerU 解析专用隔离环境（P1-D1；重依赖，不入库）
.venv-mineru/

# V2 压力档合成语料（可再生，不入库）：76.4 MB / 3 文件，占 experiments/v2/raw 的 96.2%
# 生成方式（种子固定 42，可完全复现）：
#   python scripts/v2_synth_corpus.py --n 10000  --seed 42
#   python scripts/v2_synth_corpus.py --n 30000  --seed 42
#   python scripts/v2_synth_corpus.py --n 100000 --seed 42
# 说明（2026-10-06）：仅移出版本控制，**文件仍保留在磁盘**；
# 基线提交 672143e 已含这 3 个 blob，故 .git 体积不会因此下降（需历史重写才能回收）。
# 详见 reports/p0-report-vcs-baseline-2026-10-06.md
experiments/v2/raw/corpora_v2/

# P1 解析样本：扫描件 PDF（无文本层，两份同内容共 22.7 MB，占 experiments 待入库体积 96%）
# 生成方式（种子固定 42，可完全复现）：
#   python scripts/gen_sample_pdfs.py --out-dir experiments/p1/mineru-spike/samples --seed 42
#   python scripts/gen_corpus_pdfs.py  --out-dir experiments/p1/b1-corpus           --seed 42
# 说明：仅移出版本控制，文件仍保留在磁盘；其余实验产物（jsonl/md/小 PDF）正常入库。
experiments/p1/mineru-spike/samples/sample_scanned.pdf
experiments/p1/b1-corpus/manual_scanned_dp.pdf

# P5 备份产物：含业务数据（PG dump 含 users 等表），禁止入库；
# 生产化应转存独立存储介质（见 reports/p5-backup.md §四.5）。复现命令见该报告 §三。
backups/

# 运行日志（可再生，不入库）
logs/

# 本地实跑日志：API / 前端进程重定向产物（2026-10-21 收尾轮补，此前裸放工作区）
/.api*.log
/.api*.err
/.client.log
/.client.err

# 云端配置备份：与 env/cloud.json 同含 API key，同口径禁止入库
env/cloud.json.bak*

# 个人交付素材（需求/简历等，非项目资产，不入库）
Material/

# 运行期 LangGraph trace（每次 E2E / 演示运行自动生成，属可再生运行产物，不入库）
# 注：P1–P5 期间已入库的 thr-*.jsonl 不受影响（gitignore 不追溯已跟踪文件）
reports/traces/thr-*.jsonl

# 交付包产物（deploy/package.ps1 生成，可随时重打，不入库）
dist/

# 演示/接口进程重定向日志（运行产物，不入库；正文结论见 reports/*.md）
*.err.log
*.out.log