{"metadata": {"file_suffix": "pdf", "producer": {"name": "mineru", "version": "4.0.10"}, "document": {"page_count": 2, "page_count_kind": "physical"}}, "extensions": {"mineru": {"tier": "basic", "parse_mode": "txt"}, "docvortex_layout": {"version": 1, "pages": [{"page_idx": 0, "width_pt": 595.0, "height_pt": 842.0}, {"page_idx": 1, "width_pt": 595.0, "height_pt": 842.0}]}}, "pages": [{"page_idx": 0, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.121, 0.089, 0.707, 0.112], "content": [{"type": "text", "content": "S S-80 离心泵运行与结构手册（合成样本）"}], "level": 2}, {"type": "paragraph_title", "index": 1, "bbox": [0.122, 0.127, 0.257, 0.146], "content": [{"type": "text", "content": "1 安全须知"}], "level": 2}, {"type": "text", "index": 2, "bbox": [0.119, 0.155, 0.852, 0.172], "content": [{"type": "text", "content": "S S-80（编号 S S-80）检修前必须切断电源并在配电柜悬挂“禁止合闸”标识。"}]}, {"type": "text", "index": 3, "bbox": [0.116, 0.185, 0.65, 0.202], "content": [{"type": "text", "content": "运行中严禁靠近联轴器防护罩，禁止在带压状态下拆卸法兰螺栓。"}]}, {"type": "paragraph_title", "index": 4, "bbox": [0.12, 0.22, 0.257, 0.238], "content": [{"type": "text", "content": "2 结构原理"}], "level": 2}, {"type": "text", "index": 5, "bbox": [0.119, 0.248, 0.833, 0.265], "content": [{"type": "text", "content": "S S-80 由泵壳、叶轮、轴、机械密封与轴承箱组成，电机经联轴器驱动叶轮旋转。"}]}, {"type": "text", "index": 6, "bbox": [0.116, 0.278, 0.686, 0.295], "content": [{"type": "text", "content": "叶轮旋转使液体获得动能，经蜗壳扩压转化为压力能，实现液体输送。"}]}, {"type": "paragraph_title", "index": 7, "bbox": [0.12, 0.313, 0.257, 0.331], "content": [{"type": "text", "content": "3 安装要求"}], "level": 2}, {"type": "text", "index": 8, "bbox": [0.116, 0.341, 0.852, 0.358], "content": [{"type": "text", "content": "泵组基础应有足够刚度，地脚螺栓对角紧固，联轴器同轴度偏差不超过 0.05 m m。"}]}, {"type": "text", "index": 9, "bbox": [0.116, 0.37, 0.742, 0.387], "content": [{"type": "text", "content": "吸入管路尽量短且避免气囊，进口过滤器通流面积不小于吸入管截面的三倍。"}]}, {"type": "paragraph_title", "index": 10, "bbox": [0.12, 0.405, 0.256, 0.423], "content": [{"type": "text", "content": "4 运行维护"}], "level": 2}, {"type": "text", "index": 11, "bbox": [0.116, 0.434, 0.796, 0.45], "content": [{"type": "text", "content": "轴承温度正常不超过 70 摄氏度，振动烈度控制在 4.5 m m/s 以内。"}]}, {"type": "text", "index": 12, "bbox": [0.116, 0.463, 0.797, 0.48], "content": [{"type": "text", "content": "运行 3500 小时更换一次润滑油，检查机械密封泄漏量小于 5 滴每分钟。"}]}, {"type": "paragraph_title", "index": 13, "bbox": [0.12, 0.498, 0.257, 0.516], "content": [{"type": "text", "content": "5 故障排查"}], "level": 2}, {"type": "text", "index": 14, "bbox": [0.116, 0.526, 0.74, 0.543], "content": [{"type": "text", "content": "振动超标常见转子不平衡、联轴器不对中或轴承磨损，应结合频谱分析定位。"}]}, {"type": "text", "index": 15, "bbox": [0.116, 0.556, 0.704, 0.572], "content": [{"type": "text", "content": "流量不足多与叶轮磨损、进口堵塞或密封环间隙过大有关，需逐项排查。"}]}]}, {"page_idx": 1, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.117, 0.091, 0.423, 0.112], "content": [{"type": "text", "content": "振动烈度判据表（合成样本）"}], "level": 2}, {"type": "table", "index": 1, "bbox": [0.118, 0.163, 0.878, 0.408], "content": [{"type": "table_body", "index": 1, "bbox": [0.118, 0.163, 0.878, 0.408], "content": "<table><tbody><tr><td>振动烈度 (m m/s)</td><td>设备状态</td><td>建议处置</td></tr><tr><td>&lt; 1.8</td><td>优</td><td>正常运行</td></tr><tr><td>1.8 ~ 4.5</td><td>良</td><td>加强监测</td></tr><tr><td>4.5 ~ 11.2</td><td>注意</td><td>安排检修</td></tr><tr><td>11.2 ~ 28.0</td><td>严重</td><td>尽快停机检查</td></tr><tr><td>&gt; 28.0</td><td>危险</td><td>立即停机</td></tr></tbody></table>"}]}]}], "is_full_document": true, "schema": "docvortex.middle", "schema_version": "2.0"}