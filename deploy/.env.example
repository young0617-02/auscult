# =============================================================
# Phase 6 交付包环境变量样例（deploy/.env.example）
#
# 用法：
#   Copy-Item deploy/.env.example deploy/.env
#   # 按实际环境修改 .env 后执行 deploy/up.ps1
#
# 所有变量均有代码内默认值（app/api/config.py），此处仅为
# 「干净环境一键启动」提供可编辑入口。未列出的变量走默认值。
# =============================================================

# ---- PostgreSQL（ParadeDB PG18 + pgvector + pg_search） ----
# compose 映射 5433:5432；app 默认连接 127.0.0.1:5433
API_PG_URL=postgresql://root:123456@127.0.0.1:5433/auscult_v2
LANGGRAPH_PG_URL=postgresql://root:123456@127.0.0.1:5433/auscult_v2

# ---- JWT ----
# 生产环境必须替换为随机 32+ 字节密钥
JWT_SECRET=<REDACTED_DEV_SECRET>
JWT_EXPIRE_MINUTES=480

# ---- Milvus ----
# compose 映射 19531:19530；app 默认连接 127.0.0.1:19531
# P5 复现（kee-milvus 口径）：设为 39530
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19531

# ---- Neo4j ----
NEO4J_HOST=127.0.0.1
NEO4J_PORT=7687
NEO4J_PASSWORD=auscult_p0_dev

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---- TDengine ----
TDENGINE_HOST=127.0.0.1
TDENGINE_PORT=6041

# ---- 云端预算（V5.0 §7.1：340 次/天） ----
CLOUD_BUDGET_LIMIT=340

# ---- 健康检查超时 ----
HEALTH_TIMEOUT_S=1.0
