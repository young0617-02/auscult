# =============================================================
# Phase 6 交付包环境变量样例（deploy/.env.example）
#
# 用法：
#   Copy-Item deploy/.env.example deploy/.env
#   # 按实际环境修改 .env 后执行 deploy/up.ps1
#
# 所有变量均有代码内默认值（app/api/config.py），此处仅为
# 「干净环境一键启动」提供可编辑入口。未列出的变量走默认值。
# =============================================================

# ---- PostgreSQL（ParadeDB PG18 + pgvector + pg_search） ----
# compose 映射 5433:5432；app 默认连接 127.0.0.1:5433
# ⚠️ 2026-11-09 脱敏：本文件只放**占位符**，真实口令写进 deploy/.env（已被 .gitignore 忽略）。
#    本地容器口令由 docker-compose 的 POSTGRES_PASSWORD 决定，须与下面的 <PG_PASSWORD> 一致。
API_PG_URL=postgresql://root:<PG_PASSWORD>@127.0.0.1:5433/auscult_v2
LANGGRAPH_PG_URL=postgresql://root:<PG_PASSWORD>@127.0.0.1:5433/auscult_v2

# ---- JWT ----
# 不注入时程序每次启动**随机生成**密钥（本地可用，重启后旧 token 失效）；
# 生产/外部环境必须注入稳定密钥：openssl rand -hex 32
JWT_SECRET=<generate-with-openssl-rand-hex-32>
JWT_EXPIRE_MINUTES=480

# ---- Milvus ----
# compose 映射 19531:19530；app 默认连接 127.0.0.1:19531
# P5 复现（kee-milvus 口径）：设为 39530
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19531

# ---- Neo4j ----
NEO4J_HOST=127.0.0.1
NEO4J_PORT=7687
# ⚠️ 占位符：真实值写进 deploy/.env；须与 compose 的 NEO4J_AUTH 一致
NEO4J_PASSWORD=<NEO4J_PASSWORD>

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---- TDengine ----
TDENGINE_HOST=127.0.0.1
TDENGINE_PORT=6041

# ---- 云端预算（V5.0 §7.1：340 次/天） ----
CLOUD_BUDGET_LIMIT=340

# ---- P7 诊断 Agent 化（**默认形态 = agent**，2026-10-21 所有者裁决；
#      设计文档：docs/p7-design-agent-diagnosis-2026-10-19.md） ----
# 目标形态：本地模型为主（数据不出厂），云端降为 escalate 兜底。
# 测试开发期云端承载：AUSCULT_LLM_BACKEND=cloud（AUSCULT_DIAGNOSIS_MODE 无需设置）
# 回本地（换硬件 + qwen3:32b）：AUSCULT_LLM_BACKEND=local，
#   两个模型 env 同指 qwen3:32b（单模型双角色），云端自动仅存于 escalate 兜底
# 紧急回退到固定编排：AUSCULT_DIAGNOSIS_MODE=deterministic
#AUSCULT_DIAGNOSIS_MODE=agent
#AUSCULT_LLM_BACKEND=local
#AUSCULT_LOCAL_MODEL_AGENT=qwen2.5:7b
#AUSCULT_LOCAL_MODEL_DIAGNOSE=deepseek-r1:7b
#AUSCULT_AGENT_MAX_STEPS=4
#AUSCULT_CLOUD_BUDGET_LIMIT=340
#AUSCULT_RETRIEVAL_DEVICE=cuda
# 出网脱敏（2026-10-21 口径：合规以本地部署为准）：
#   auto（默认）= 仅 cloud 后端脱敏；on = 强制；off = 强制关闭
#AUSCULT_SANITIZE_OUTBOUND=auto
# 本地模型失败（重试耗尽）→ 云端兜底；纯离线开发设 0
#AUSCULT_CLOUD_FALLBACK=1

# ---- 健康检查超时 ----
HEALTH_TIMEOUT_S=1.0
